  "peerDependencies": {
    "expo": "*",
    "expo-modules-core": "*",
    "react-native": ">=0.74.0"
  },
  "peerDependenciesMeta": {
    "expo": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SpeedshieldTechnologies/react-native-ssh-sftp.git"
