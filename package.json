{
  "name": "@speedshield/react-native-ssh-sftp",
  "version": "3.0.0",
  "description": "SSH and SFTP client library for React Native",
  "main": "lib/sshclient.js",
  "scripts": {
    "_postinstall": "npm run compile",
    "build": "npm run compile && npm pack",
    "precompile": "npm run lint:build",
    "compile": "npx tsc",
    "lint": "eslint .",
    "lint:build": "cross-env NODE_ENV=production npm run lint -- --max-warnings 20",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run compile && changeset publish"
  },
  "keywords": [
    "react-native",
    "ssh",
    "sftp"
  ],
  "homepage": "https://github.com/SpeedshieldTechnologies/react-native-ssh-sftp#readme",
